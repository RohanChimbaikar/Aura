# ==============================================================================
# Aura Steganography Platform - Root Git Ignore Configuration
# ==============================================================================

# =========================
# Python and Virtual Env
# =========================
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.pycache_tmp/
.venv/
venv/
backend/.venv/

# =========================
# Node / Frontend
# =========================
node_modules/
frontend/node_modules/
dist/
frontend/dist/
*.tsbuildinfo

# =========================
# Environment configuration
# =========================
.env
.env.*
!.env.example
backend/.env

# =========================
# Local Databases & State
# =========================
*.db
*.sqlite
*.sqlite3
backend/instance/*.db
backend/instance/*.json
!backend/instance/.gitkeep

# =========================
# IDE and Tooling Cache
# =========================
.DS_Store
Thumbs.db
*~
*.tmp
*.log
.vscode/
.idea/
.vexp/

# =========================
# ML Checkpoints
# =========================
*.pt
*.pth
*.ckpt
*.onnx
*.bin

# EXCLUDE required application model weights from ignore
!backend/aura-model-v1/aura_v2r_decoder_only.pt
!backend/aura-model-v1/aura_v2r_best.pt

# =========================
# Audio & Generated Assets
# =========================
*.wav
*.mp3
*.flac
*.zip

# EXCLUDE the approved carrier audio bank from ignore
!backend/aura_carrier_bank/*.wav

# =========================
# Stego Outputs & Uploads
# =========================
backend/outputs/*
!backend/outputs/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep